<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vikis Sweets Shop</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>Welcome to Viki's Sweets Shop!</h1>
  <div id="login-section">
    <% if (!user) { %>
      <a href="/login" id="login-link">Login with SAP CDC</a>
      <button id="login-popup-btn" type="button">Login with SAP CDC (Popup)</button>
      <script>
        document.getElementById('login-popup-btn').onclick = function() {
          const popup = window.open('/login', 'oidcLogin', 'width=500,height=700');
          window.addEventListener('message', function(event) {
            if (event.data && event.data.type === 'oidc-login') {
              if (event.data.success === 'true' || event.data.success === true) {
                window.location.reload();
              } else {
                alert('Login failed: ' + (event.data.error || 'Unknown error'));
              }
            }
          }, { once: true });
        };
      </script>
    <% } else { %>
      <a href="/profile">Profile</a> |
      <a href="/logout">Logout</a>
    <% } %>
  </div>
  <div id="catalog-section">
    <h2>Candies Catalog</h2>
    <% if (!user) { %>
      <div class="login-required">Please <a href="/login">log in</a> to view the candies catalog.</div>
    <% } else { %>
      <div id="candies-list">
        <% candies.forEach(function(candy) { %>
          <% if (!candy.special || showSpecial) { %>
            <div class="candy-item">
              <img src="<%= candy.img %>" alt="<%= candy.name %>" width="80" />
              <div><strong><%= candy.name %></strong></div>
              <div>Price: $<%= candy.price.toFixed(2) %></div>
              <% if (candy.special) { %>
                <div class="special-label">Special (Club members only)</div>
              <% } %>
            </div>
          <% } %>
        <% }); %>
      </div>
      <% if (showSendCandy) { %>
        <form id="send-candy-form" method="POST" action="/send-candy">
          <h3>Send candy to a friend</h3>
          <input type="text" name="friendName" placeholder="Friend's Name" required />
          <input type="text" name="address" placeholder="Address" required />
          <textarea name="message" placeholder="A few words to the receiver"></textarea>
          <button type="submit">Send</button>
          <button type="button" onclick="document.getElementById('send-candy-form').reset();">Cancel</button>
        </form>
      <% } %>
    <% } %>
  </div>
</body>
</html> 