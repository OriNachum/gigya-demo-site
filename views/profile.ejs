<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Profile</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>User Profile</h1>
  <table>
    <% for (const key in profile) { %>
      <tr>
        <td><%= key %></td>
        <td><%= profile[key] %></td>
      </tr>
    <% } %>
  </table>
  <a href="/">Back to Home</a>
</body>
</html> 